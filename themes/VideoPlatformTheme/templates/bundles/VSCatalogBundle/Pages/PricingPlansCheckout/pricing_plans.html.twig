{% extends "base.html.twig" %}

{% block title %}{{ parent() }} :: {{ 'vs_vvp.template.pricing_plans.pricing_plans' | trans( {},'VanzVideoPlayer' ) }}{% endblock %}
{% block pageTitle %}{{ 'vs_vvp.template.pricing_plans.pricing_plans' | trans( {},'VanzVideoPlayer' ) }}{% endblock %}

{% block content %}
    {% include '@VSCatalog/Pages/PricingPlansCheckout/Partial/pricing-plans-listing.html.twig' %}
    
    {% include 'Partial/our-features.html.twig' %}
    
    {% include 'Partial/partners.html.twig' %}
{% endblock %}

{% block widgets %}
    <script type="text/javascript" src="https://js.stripe.com/v2/"></script>
    <div id="RealPaymentFormContainer" style="display: none;">
        {% include '@VSPayment/Pages/CreditCard/Partial/StripeJsV2Form.html.twig' with {
             'formAction': '',
             'formMethod': 'POST'
        } %}
    </div>
{% endblock %}

{% block modals %}
    {% include '@VSCatalog/Pages/PricingPlansCheckout/plan-modal.html.twig' %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    
    {{ encore_entry_link_tags( 'js/pricing-plans', null, 'VideoPlatformTheme' ) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {{ encore_entry_script_tags( 'js/pricing-plans', null, 'VideoPlatformTheme' ) }}
    {{ encore_entry_script_tags( 'js/profile', null, 'VideoPlatformTheme' ) }}
{% endblock %}
