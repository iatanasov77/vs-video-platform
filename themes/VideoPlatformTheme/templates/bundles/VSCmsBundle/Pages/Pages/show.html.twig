{% extends 'base.html.twig' %} 

{% block title %}{{ parent() }} :: {{ resource.title }}{% endblock %}
{% block pageTitle %}{{ resource.title }}{% endblock %}

{% block breadcrumbs %}
    {{ parent() }}
    <li class="breadcrumbs__item breadcrumbs__item--active">{{ resource.title }}</li>
{% endblock %}

{% block content %}
    <!-- privacy -->
    <section class="section">
        {{ resource.text | raw }}
    </section>
    <!-- end privacy -->
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {{ encore_entry_script_tags( 'js/static-page', null, 'VideoPlatformTheme' ) }}
{% endblock %}