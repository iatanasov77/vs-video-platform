<!DOCTYPE html>
<html lang="{{ app.request.locale|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    {% block stylesheets %}
        <!-- CSS -->
        {{ encore_entry_link_tags( 'css/main', null, 'VideoPlatformTheme' ) }}
        {{ encore_entry_link_tags( 'js/app', null, 'VideoPlatformTheme' ) }}
    {% endblock %}
    {% block javascripts_head %}{% endblock %}

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="{{ asset( 'build/video-platform-theme/icon/favicon-32x32.png' ) }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ asset( 'build/video-platform-theme/icon/favicon-32x32.png' ) }}">

    <meta name="description" content="Online Movies, TV Shows & Cinema HTML Template">
    <meta name="keywords" content="">
    <meta name="author" content="Dmitry Volkov">
    <title>{{ applicationTitle }}</title>

</head>
<body>
    {% include 'Layout/alerts.html.twig' %}
    {% include 'Layout/header.html.twig' %}
    {% include 'Layout/mobile-nav.html.twig' %}
    
    <div id="content" data-analyticsMeasurementId={{ analyticsMeasurementId }}>
        {% if app.request.attributes.get('_route') != 'app_home' %}
            <!-- page title -->
            <section class="section section--first section--bg"
                {# data-bg="{{ asset( 'build/video-platform-theme/img/bg/section__bg.jpg' ) }}" #}
            >
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="section__wrap">
                                <!-- section title -->
                                <h1 class="section__title section__title--head">{% block pageTitle %}{% endblock %}</h1>
                                <!-- end section title -->
        
                                <!-- breadcrumbs -->
                                <ul class="breadcrumbs">
                                    {% block breadcrumbs %}
                                        {{ knp_menu_render( 'breadcrumbs', {'template': 'Menu/breadcrumb.html.twig'} ) }}
                                    {% endblock %}
                                </ul>
                                <!-- end breadcrumbs -->
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- end page title -->
        {% endif %}
    
        {% block content %}{% endblock %}
    </div>
    
    {% include 'Layout/footer.html.twig' %}
    
    {% block mobile_widgets %}{% endblock %}
    {% block modals %}{% endblock %}
        
    {% block javascripts %}
        {{ encore_entry_script_tags( 'js/app', null, 'VideoPlatformTheme' ) }}
    {% endblock %}
</body>
</html>